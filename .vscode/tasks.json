{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Current Docker Status",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"ps",
				"-a"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Recent Pipeline Errors",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"logs",
				"--since",
				"2h",
				"--tail",
				"100",
				"kafka",
				"ingestion",
				"spark-bronze",
				"spark-master",
				"spark-worker"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify Current Compose",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"config",
				"--quiet"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify Kafka Health",
			"type": "shell",
			"command": "docker",
			"args": [
				"inspect",
				"--format={{json .State.Health}}",
				"egypt-air-quality-kafka-1"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "pytest-ingestion",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"pytest",
				"-q",
				"ingestion/tests"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "install-python-deps",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"pip",
				"install",
				"python-dotenv",
				"kafka-python"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "git-status",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short",
				"--branch"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	]
}