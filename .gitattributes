# Files executed inside Linux containers must keep LF endings even when
# checked out on Windows (core.autocrlf=true), otherwise shebangs and
# entrypoints break with "bad interpreter" / "\r: command not found".
*.sh        text eol=lf
*.py        text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile  text eol=lf
*.Dockerfile text eol=lf
*.conf      text eol=lf
*.bicep     text eol=lf

# Windows-only scripts keep CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary artifacts.
*.parquet   binary
*.p12       binary
*.pkl       binary
