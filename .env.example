# =========================================================
# PROJECT CONFIGURATION
# =========================================================

PROJECT_NAME=Egypt Air Quality Intelligence Platform
PROJECT_TIMEZONE=Africa/Cairo
ENVIRONMENT=development

# =========================================================
# POSTGRESQL CONFIGURATION
# =========================================================

POSTGRES_ADMIN_PASSWORD=replace_with_long_random_password
APP_DB_PASSWORD=replace_with_another_long_random_password
AIRFLOW_DB_PASSWORD=replace_with_another_long_random_password

# =========================================================
# AIRFLOW CONFIGURATION
# =========================================================

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=replace_with_long_random_password
# Generate locally with Airflow/Fernet tooling; never reuse a committed key.
AIRFLOW_FERNET_KEY=
AIRFLOW_UID=50000

# =========================================================
# OPENAQ API CONFIGURATION
# =========================================================

OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3
OPENAQ_COUNTRY_CODE=EG
OPENAQ_PAGE_LIMIT=1000

# =========================================================
# OPEN-METEO AIR QUALITY CONFIGURATION
# =========================================================

OPEN_METEO_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_FORECAST_DAYS=2

# =========================================================
# OPEN-METEO WEATHER CONFIGURATION
# =========================================================

OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_WEATHER_FORECAST_DAYS=2

# =========================================================
# PROJECT LOCATION CONFIGURATION
# =========================================================

COUNTRY_CODE=EG
COUNTRY_NAME=Egypt

# Default coordinates (Cairo)
# Governorate-specific coordinates are defined in governorates.py

PROJECT_LATITUDE=30.0444
PROJECT_LONGITUDE=31.2357

# =========================================================
# KAFKA CONFIGURATION
# =========================================================

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# Spark Bronze Ingestion
MAX_OFFSETS_PER_TRIGGER=500
DASHBOARD_LOOKBACK_DAYS=30

KAFKA_AIR_QUALITY_TOPIC=air-quality
KAFKA_WEATHER_TOPIC=weather
KAFKA_OPENAQ_TOPIC=openaq-measurements

KAFKA_GROUP_ID=egypt-air-quality-consumer
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false

# =========================================================
# MQTT CONFIGURATION
# =========================================================

MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883

MQTT_USERNAME=
MQTT_PASSWORD=

MQTT_AIR_QUALITY_TOPIC=sensors/air-quality
MQTT_WEATHER_TOPIC=sensors/weather

MQTT_KEEPALIVE=60
MQTT_PUBLISH_QUEUE_SIZE=500

# =========================================================
# DATA INGESTION CONFIGURATION
# =========================================================

INGESTION_REQUEST_TIMEOUT=30
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_BACKOFF=2

INGESTION_LOG_LEVEL=INFO
INGESTION_BATCH_SIZE=100
INGESTION_INTERVAL_MINUTES=60

# =========================================================
# STORAGE CONFIGURATION
# =========================================================

DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
LOG_DIR=./data/logs

# =========================================================
# APPLICATION DATABASE CONFIGURATION
# =========================================================

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=airquality
DATABASE_USER=airquality

# =========================================================
# ANOMALY DETECTION / TELEGRAM ALERTING
# =========================================================

ANOMALY_POLL_SECONDS=120
ANOMALY_LOOKBACK_DAYS=8
ANOMALY_MIN_BASELINE_POINTS=12
ANOMALY_MAD_MULTIPLIER=3.5
ANOMALY_RELATIVE_FLOOR=0.25
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =========================================================
# STREAMLIT CONFIGURATION
# =========================================================

STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

SPARK_WORKER_MEMORY=2048m
SPARK_WORKER_CORES=3

# Cloudflare R2 S3-compatible backup storage (use an R2 S3 API token scoped to this bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=egypt-air-quality
